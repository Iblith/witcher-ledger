{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist/site",
  "framework": null,
  "headers": [
    { "source": "/(.*)/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
